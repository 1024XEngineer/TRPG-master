{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-result.schema.json",
  "$defs": {
    "RuleCheckResult": {
      "additionalProperties": false,
      "description": "Player-safe evidence for one authoritative percentile check.",
      "properties": {
        "checkpoint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Id"
        },
        "skill_id": {
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "target_value": {
          "minimum": 0,
          "title": "Target Value",
          "type": "integer"
        },
        "roll_value": {
          "maximum": 100,
          "minimum": 1,
          "title": "Roll Value",
          "type": "integer"
        },
        "difficulty": {
          "enum": [
            "regular",
            "hard",
            "extreme"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "success_level": {
          "enum": [
            "critical",
            "extreme",
            "hard",
            "regular",
            "failure",
            "fumble"
          ],
          "title": "Success Level",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "skill_id",
        "target_value",
        "roll_value",
        "difficulty",
        "success_level",
        "passed"
      ],
      "title": "RuleCheckResult",
      "type": "object"
    },
    "VisibleFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "VisibleFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Player-safe result; engine state changes and Event payloads are excluded.",
  "properties": {
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "action_id": {
      "minLength": 1,
      "title": "Action Id",
      "type": "string"
    },
    "resolution": {
      "enum": [
        "checkpoint",
        "direct",
        "blocked",
        "unrecognized"
      ],
      "title": "Resolution",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "success",
        "failure",
        "not_applicable"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "check_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleCheckResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "visible_facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VisibleFact"
      },
      "title": "Visible Facts",
      "type": "array"
    },
    "narration_constraints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Narration Constraints",
      "type": "array"
    },
    "view_revision": {
      "minLength": 1,
      "title": "View Revision",
      "type": "string"
    },
    "event_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Event Refs",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "action_id",
    "resolution",
    "outcome",
    "view_revision"
  ],
  "title": "ActionResult",
  "type": "object"
}
