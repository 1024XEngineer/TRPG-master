{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "host-agent-context.schema.json",
  "$defs": {
    "ActionDeclarationOption": {
      "additionalProperties": false,
      "description": "Player-safe declaration id and semantic cues supplied by one checkpoint.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "semantic_hints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Hints",
          "type": "array"
        }
      },
      "required": [
        "id",
        "semantic_hints"
      ],
      "title": "ActionDeclarationOption",
      "type": "object"
    },
    "ActorResourceView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ActorResourceView",
      "type": "object"
    },
    "ActorValueView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ActorValueView",
      "type": "object"
    },
    "AvailableExitView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitDestinationView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AvailableExitView",
      "type": "object"
    },
    "CheckpointOption": {
      "additionalProperties": false,
      "description": "Trusted candidate menu exposed to the host semantic matcher.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "action_hint": {
          "minLength": 1,
          "title": "Action Hint",
          "type": "string"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": [
                "regular",
                "hard",
                "extreme"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "declaration_options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionDeclarationOption"
          },
          "title": "Declaration Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "target_id",
        "action_hint"
      ],
      "title": "CheckpointOption",
      "type": "object"
    },
    "ExitDestinationView": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "name"
      ],
      "title": "ExitDestinationView",
      "type": "object"
    },
    "JsonValue": {},
    "KnownInformationView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "related_entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Entities",
          "type": "array"
        },
        "related_scenes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Scenes",
          "type": "array"
        },
        "scope": {
          "enum": [
            "actor",
            "party"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "content",
        "scope"
      ],
      "title": "KnownInformationView",
      "type": "object"
    },
    "NarrativeDetailView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "description",
            "sensory",
            "atmosphere",
            "pacing",
            "foreshadowing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "NarrativeDetailView",
      "type": "object"
    },
    "ObservableStateView": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "key",
        "label",
        "value"
      ],
      "title": "ObservableStateView",
      "type": "object"
    },
    "PlayerInput": {
      "additionalProperties": false,
      "properties": {
        "room_id": {
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "client_action_id": {
          "minLength": 1,
          "title": "Client Action Id",
          "type": "string"
        },
        "utterance": {
          "minLength": 1,
          "title": "Utterance",
          "type": "string"
        }
      },
      "required": [
        "room_id",
        "player_id",
        "actor_id",
        "client_action_id",
        "utterance"
      ],
      "title": "PlayerInput",
      "type": "object"
    },
    "PlayerView": {
      "additionalProperties": false,
      "description": "Complete player-safe world snapshot used by one model/Agent run.",
      "properties": {
        "room_id": {
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "background": {
          "minLength": 1,
          "title": "Background",
          "type": "string"
        },
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "playing",
            "ended"
          ],
          "title": "Phase",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "self_actor": {
          "$ref": "#/$defs/SelfActorView"
        },
        "scene": {
          "$ref": "#/$defs/SceneView"
        },
        "known_information": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnownInformationView"
          },
          "title": "Known Information",
          "type": "array"
        },
        "checkpoint_options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CheckpointOption"
          },
          "title": "Checkpoint Options",
          "type": "array"
        }
      },
      "required": [
        "room_id",
        "player_id",
        "actor_id",
        "background",
        "scene_id",
        "phase",
        "revision",
        "self_actor",
        "scene"
      ],
      "title": "PlayerView",
      "type": "object"
    },
    "RecentSafeResult": {
      "additionalProperties": false,
      "description": "The deliberately small, player-safe projection of an ActionResult.",
      "properties": {
        "resolution": {
          "enum": [
            "checkpoint",
            "direct",
            "blocked",
            "unrecognized"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "not_applicable"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "check_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleCheckResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visible_facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleFact"
          },
          "title": "Visible Facts",
          "type": "array"
        }
      },
      "required": [
        "resolution",
        "outcome"
      ],
      "title": "RecentSafeResult",
      "type": "object"
    },
    "RecentTurn": {
      "additionalProperties": false,
      "description": "One prior action and only the evidence safe for the current viewer.",
      "properties": {
        "correlation_id": {
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "source_player_id": {
          "minLength": 1,
          "title": "Source Player Id",
          "type": "string"
        },
        "source_actor_id": {
          "minLength": 1,
          "title": "Source Actor Id",
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "source_view_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source View Revision"
        },
        "committed_view_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Committed View Revision"
        },
        "participants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "player_utterance": {
          "$ref": "#/$defs/VisibleHistoryText"
        },
        "accepted_intent_summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accepted Intent Summary"
        },
        "player_safe_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecentSafeResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "published_narration": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisibleHistoryText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "correlation_id",
        "source_player_id",
        "source_actor_id",
        "player_utterance"
      ],
      "title": "RecentTurn",
      "type": "object"
    },
    "RecentTurnContext": {
      "additionalProperties": false,
      "description": "A revision-bound sequence of recent turns visible to one player.",
      "properties": {
        "room_id": {
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "viewer_player_id": {
          "minLength": 1,
          "title": "Viewer Player Id",
          "type": "string"
        },
        "as_of_revision": {
          "minLength": 1,
          "title": "As Of Revision",
          "type": "string"
        },
        "turns": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecentTurn"
          },
          "title": "Turns",
          "type": "array"
        }
      },
      "required": [
        "room_id",
        "viewer_player_id",
        "as_of_revision"
      ],
      "title": "RecentTurnContext",
      "type": "object"
    },
    "RuleCheckResult": {
      "additionalProperties": false,
      "description": "Player-safe evidence for one authoritative percentile check.",
      "properties": {
        "checkpoint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Id"
        },
        "skill_id": {
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "target_value": {
          "minimum": 0,
          "title": "Target Value",
          "type": "integer"
        },
        "roll_value": {
          "maximum": 100,
          "minimum": 1,
          "title": "Roll Value",
          "type": "integer"
        },
        "difficulty": {
          "enum": [
            "regular",
            "hard",
            "extreme"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "success_level": {
          "enum": [
            "critical",
            "extreme",
            "hard",
            "regular",
            "failure",
            "fumble"
          ],
          "title": "Success Level",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "skill_id",
        "target_value",
        "roll_value",
        "difficulty",
        "success_level",
        "passed"
      ],
      "title": "RuleCheckResult",
      "type": "object"
    },
    "SceneView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrativeDetailView"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "visible_entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleEntity"
          },
          "title": "Visible Entities",
          "type": "array"
        },
        "visible_actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleActorView"
          },
          "title": "Visible Actors",
          "type": "array"
        },
        "available_exits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AvailableExitView"
          },
          "title": "Available Exits",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "SceneView",
      "type": "object"
    },
    "SelfActorView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorValueView"
          },
          "title": "Attributes",
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorValueView"
          },
          "title": "Skills",
          "type": "array"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorResourceView"
          },
          "title": "Resources",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "equipment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Equipment",
          "type": "array"
        },
        "background_summary": {
          "default": "",
          "title": "Background Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "SelfActorView",
      "type": "object"
    },
    "VisibleActorView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status_summary": {
          "default": "",
          "title": "Status Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "VisibleActorView",
      "type": "object"
    },
    "VisibleEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "npc",
            "object",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrativeDetailView"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "observable_state": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservableStateView"
          },
          "title": "Observable State",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ],
      "title": "VisibleEntity",
      "type": "object"
    },
    "VisibleFact": {
      "additionalProperties": false,
      "description": "One fact confirmed for the current action result.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "VisibleFact",
      "type": "object"
    },
    "VisibleHistoryText": {
      "additionalProperties": false,
      "description": "Text already visible to the current viewer at publication time.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "player_scoped"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "text",
        "visibility"
      ],
      "title": "VisibleHistoryText",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Trusted player input paired with B's player-safe scoped view.",
  "properties": {
    "player_input": {
      "$ref": "#/$defs/PlayerInput"
    },
    "player_view": {
      "$ref": "#/$defs/PlayerView"
    },
    "recent_history": {
      "$ref": "#/$defs/RecentTurnContext"
    }
  },
  "required": [
    "player_input",
    "player_view",
    "recent_history"
  ],
  "title": "HostAgentContext",
  "type": "object"
}
