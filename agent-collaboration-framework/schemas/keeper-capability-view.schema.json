{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keeper-capability-view.schema.json",
  "$defs": {
    "KeeperEndingCapability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "title": "KeeperEndingCapability",
      "type": "object"
    },
    "KeeperEntityCapability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "npc",
            "object",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "enum": [
            "canon",
            "runtime"
          ],
          "title": "Origin",
          "type": "string"
        },
        "location_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "holder_actor_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder Actor Id"
        },
        "consumed": {
          "default": false,
          "title": "Consumed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "origin"
      ],
      "title": "KeeperEntityCapability",
      "type": "object"
    },
    "KeeperInformationCapability": {
      "additionalProperties": false,
      "description": "One Canon Information the Agent may reveal or hide.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "related_entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Entities",
          "type": "array"
        },
        "related_scenes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Scenes",
          "type": "array"
        },
        "known_by_party": {
          "default": false,
          "title": "Known By Party",
          "type": "boolean"
        },
        "known_by_actor": {
          "default": false,
          "title": "Known By Actor",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "content"
      ],
      "title": "KeeperInformationCapability",
      "type": "object"
    },
    "KeeperLocationCapability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "enum": [
            "canon",
            "runtime"
          ],
          "title": "Origin",
          "type": "string"
        },
        "is_current": {
          "default": false,
          "title": "Is Current",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "origin"
      ],
      "title": "KeeperLocationCapability",
      "type": "object"
    },
    "KeeperRuleCandidate": {
      "additionalProperties": false,
      "description": "An `agent_match` Rule that could apply where the actor currently is.\n\nThis is the minimal Rule Match View of #226 §2: the Engine decides which\nrules are even in scope, and the Agent only judges which option the player's\nwords mean. It rides on the Keeper view because it is keeper-side, agent-only\ndata that must never reach the client — the same boundary #226 draws between\nthe Match View and PlayerView.",
      "properties": {
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "question_kind": {
          "enum": [
            "action_declaration",
            "method",
            "intent_relation"
          ],
          "title": "Question Kind",
          "type": "string"
        },
        "semantic_hints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Semantic Hints",
          "type": "array"
        },
        "action_families": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Action Families",
          "type": "array"
        },
        "target_kinds": {
          "default": [],
          "items": {
            "enum": [
              "information",
              "entity",
              "location",
              "actor",
              "world"
            ],
            "type": "string"
          },
          "title": "Target Kinds",
          "type": "array"
        },
        "target_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        },
        "options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KeeperRuleOption"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "question_kind"
      ],
      "title": "KeeperRuleCandidate",
      "type": "object"
    },
    "KeeperRuleOption": {
      "additionalProperties": false,
      "description": "One opaque choice on a rule's candidate menu.\n\nThe Agent submits `id` and nothing else; what the option *does* stays on the\nserver, so a creative model cannot pick an outcome (#226 §1).\n\n`requires_check` is the one exception, and it is not an outcome: it says\nonly whether this branch rolls dice. The Agent has to know, because it must\ndecide between proposing a check and proposing none — without it the prompt\nhad to tell the model to always send a check and reuse the option id as a\nskill id, which breaks for options that name no skill at all (`proceed`,\n`STR`). The player sees the dice either way, so nothing hidden leaks.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "semantic_hints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Semantic Hints",
          "type": "array"
        },
        "requires_check": {
          "default": true,
          "title": "Requires Check",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "KeeperRuleOption",
      "type": "object"
    },
    "KeeperTimeCapability": {
      "additionalProperties": false,
      "description": "What one `advance_world_time` effect would do, and whether it may run.\n\nThe Agent has to be able to count jumps (\"sleep until 20:00\" is two of\nthem), so it needs the ordered points, not just the next one. `blocked_reason`\nis populated instead of hiding the capability, because \"you cannot advance\ntime here, and here is why\" is what lets the Agent say something true to the\nplayer rather than silently doing nothing.",
      "properties": {
        "current_point_id": {
          "minLength": 1,
          "title": "Current Point Id",
          "type": "string"
        },
        "current_hour_of_day": {
          "maximum": 23,
          "minimum": 0,
          "title": "Current Hour Of Day",
          "type": "integer"
        },
        "current_day_index": {
          "minimum": 0,
          "title": "Current Day Index",
          "type": "integer"
        },
        "next_point_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Point Id"
        },
        "ordered_point_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ordered Point Ids",
          "type": "array"
        },
        "blocked_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocked Reason"
        }
      },
      "required": [
        "current_point_id",
        "current_hour_of_day",
        "current_day_index"
      ],
      "title": "KeeperTimeCapability",
      "type": "object"
    },
    "WorldProfileSpec": {
      "additionalProperties": false,
      "description": "Setting constraints the Agent must respect when proposing Runtime content.\n\nProvisional: #212 §7.5 only requires that an Agent-proposed inn \"符合\nworld_profile\". Modelled with the minimum needed to judge that, so a later\nissue can extend it without unwinding invented structure.",
      "properties": {
        "era": {
          "default": "",
          "maxLength": 100,
          "title": "Era",
          "type": "string"
        },
        "region": {
          "default": "",
          "maxLength": 100,
          "title": "Region",
          "type": "string"
        },
        "technology_level": {
          "default": "",
          "maxLength": 100,
          "title": "Technology Level",
          "type": "string"
        },
        "tone": {
          "default": "",
          "maxLength": 200,
          "title": "Tone",
          "type": "string"
        },
        "forbidden_content": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Forbidden Content",
          "type": "array"
        }
      },
      "title": "WorldProfileSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the Agent needs to name a legal target or effect payload.",
  "properties": {
    "room_id": {
      "minLength": 1,
      "title": "Room Id",
      "type": "string"
    },
    "actor_id": {
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "world_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "World Id"
    },
    "world_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorldProfileSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "information": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperInformationCapability"
      },
      "title": "Information",
      "type": "array"
    },
    "locations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperLocationCapability"
      },
      "title": "Locations",
      "type": "array"
    },
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperEntityCapability"
      },
      "title": "Entities",
      "type": "array"
    },
    "endings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperEndingCapability"
      },
      "title": "Endings",
      "type": "array"
    },
    "rule_candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperRuleCandidate"
      },
      "title": "Rule Candidates",
      "type": "array"
    },
    "time": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeeperTimeCapability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "core_resolved": {
      "default": false,
      "title": "Core Resolved",
      "type": "boolean"
    },
    "ending_available": {
      "default": false,
      "title": "Ending Available",
      "type": "boolean"
    }
  },
  "required": [
    "room_id",
    "actor_id",
    "revision"
  ],
  "title": "KeeperCapabilityView",
  "type": "object"
}
