{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keeper-capability-view.schema.json",
  "$defs": {
    "KeeperEndingCapability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "summary"
      ],
      "title": "KeeperEndingCapability",
      "type": "object"
    },
    "KeeperEntityCapability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "npc",
            "object",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "enum": [
            "canon",
            "runtime"
          ],
          "title": "Origin",
          "type": "string"
        },
        "location_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "holder_actor_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder Actor Id"
        },
        "consumed": {
          "default": false,
          "title": "Consumed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "origin"
      ],
      "title": "KeeperEntityCapability",
      "type": "object"
    },
    "KeeperInformationCapability": {
      "additionalProperties": false,
      "description": "One Canon Information the Agent may reveal or hide.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "related_entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Entities",
          "type": "array"
        },
        "related_scenes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Scenes",
          "type": "array"
        },
        "known_by_party": {
          "default": false,
          "title": "Known By Party",
          "type": "boolean"
        },
        "known_by_actor": {
          "default": false,
          "title": "Known By Actor",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "content"
      ],
      "title": "KeeperInformationCapability",
      "type": "object"
    },
    "KeeperLocationCapability": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "enum": [
            "canon",
            "runtime"
          ],
          "title": "Origin",
          "type": "string"
        },
        "is_current": {
          "default": false,
          "title": "Is Current",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "origin"
      ],
      "title": "KeeperLocationCapability",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the Agent needs to name a legal target or effect payload.",
  "properties": {
    "room_id": {
      "minLength": 1,
      "title": "Room Id",
      "type": "string"
    },
    "actor_id": {
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "information": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperInformationCapability"
      },
      "title": "Information",
      "type": "array"
    },
    "locations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperLocationCapability"
      },
      "title": "Locations",
      "type": "array"
    },
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperEntityCapability"
      },
      "title": "Entities",
      "type": "array"
    },
    "endings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KeeperEndingCapability"
      },
      "title": "Endings",
      "type": "array"
    },
    "core_resolved": {
      "default": false,
      "title": "Core Resolved",
      "type": "boolean"
    },
    "ending_available": {
      "default": false,
      "title": "Ending Available",
      "type": "boolean"
    }
  },
  "required": [
    "room_id",
    "actor_id",
    "revision"
  ],
  "title": "KeeperCapabilityView",
  "type": "object"
}
