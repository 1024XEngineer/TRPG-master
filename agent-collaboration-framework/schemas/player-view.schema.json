{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "player-view.schema.json",
  "$defs": {
    "ActionDeclarationOption": {
      "additionalProperties": false,
      "description": "Player-safe declaration id and semantic cues supplied by one checkpoint.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "semantic_hints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Hints",
          "type": "array"
        }
      },
      "required": [
        "id",
        "semantic_hints"
      ],
      "title": "ActionDeclarationOption",
      "type": "object"
    },
    "ActorResourceView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ActorResourceView",
      "type": "object"
    },
    "ActorValueView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ActorValueView",
      "type": "object"
    },
    "AvailableExitView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitDestinationView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AvailableExitView",
      "type": "object"
    },
    "CheckpointOption": {
      "additionalProperties": false,
      "description": "Trusted candidate menu exposed to the host semantic matcher.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "action_hint": {
          "minLength": 1,
          "title": "Action Hint",
          "type": "string"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": [
                "regular",
                "hard",
                "extreme"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "declaration_options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionDeclarationOption"
          },
          "title": "Declaration Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "target_id",
        "action_hint"
      ],
      "title": "CheckpointOption",
      "type": "object"
    },
    "ExitDestinationView": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "name"
      ],
      "title": "ExitDestinationView",
      "type": "object"
    },
    "JsonValue": {},
    "KnownInformationView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "related_entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Entities",
          "type": "array"
        },
        "related_scenes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Scenes",
          "type": "array"
        },
        "scope": {
          "enum": [
            "actor",
            "party"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "content",
        "scope"
      ],
      "title": "KnownInformationView",
      "type": "object"
    },
    "NarrativeDetailView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "description",
            "sensory",
            "atmosphere",
            "pacing",
            "foreshadowing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "NarrativeDetailView",
      "type": "object"
    },
    "ObservableStateView": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "key",
        "label",
        "value"
      ],
      "title": "ObservableStateView",
      "type": "object"
    },
    "SceneView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrativeDetailView"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "visible_entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleEntity"
          },
          "title": "Visible Entities",
          "type": "array"
        },
        "visible_actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleActorView"
          },
          "title": "Visible Actors",
          "type": "array"
        },
        "available_exits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AvailableExitView"
          },
          "title": "Available Exits",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "SceneView",
      "type": "object"
    },
    "SelfActorView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorValueView"
          },
          "title": "Attributes",
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorValueView"
          },
          "title": "Skills",
          "type": "array"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorResourceView"
          },
          "title": "Resources",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "equipment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Equipment",
          "type": "array"
        },
        "background_summary": {
          "default": "",
          "title": "Background Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "SelfActorView",
      "type": "object"
    },
    "VisibleActorView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status_summary": {
          "default": "",
          "title": "Status Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "VisibleActorView",
      "type": "object"
    },
    "VisibleEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "npc",
            "object",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrativeDetailView"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "observable_state": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservableStateView"
          },
          "title": "Observable State",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ],
      "title": "VisibleEntity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete player-safe world snapshot used by one model/Agent run.",
  "properties": {
    "room_id": {
      "minLength": 1,
      "title": "Room Id",
      "type": "string"
    },
    "player_id": {
      "minLength": 1,
      "title": "Player Id",
      "type": "string"
    },
    "actor_id": {
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "background": {
      "minLength": 1,
      "title": "Background",
      "type": "string"
    },
    "scene_id": {
      "minLength": 1,
      "title": "Scene Id",
      "type": "string"
    },
    "phase": {
      "enum": [
        "playing",
        "ended"
      ],
      "title": "Phase",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "self_actor": {
      "$ref": "#/$defs/SelfActorView"
    },
    "scene": {
      "$ref": "#/$defs/SceneView"
    },
    "known_information": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KnownInformationView"
      },
      "title": "Known Information",
      "type": "array"
    },
    "checkpoint_options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CheckpointOption"
      },
      "title": "Checkpoint Options",
      "type": "array"
    }
  },
  "required": [
    "room_id",
    "player_id",
    "actor_id",
    "background",
    "scene_id",
    "phase",
    "revision",
    "self_actor",
    "scene"
  ],
  "title": "PlayerView",
  "type": "object"
}
