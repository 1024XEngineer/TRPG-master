          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionExitDestination"
            },
            {
              "type": "null"
