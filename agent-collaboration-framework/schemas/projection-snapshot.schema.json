{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projection-snapshot.schema.json",
  "$defs": {
    "JsonValue": {},
    "ProjectionActorResource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ProjectionActorResource",
      "type": "object"
    },
    "ProjectionActorValue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ProjectionActorValue",
      "type": "object"
    },
    "ProjectionAvailableExit": {
      "additionalProperties": false,
