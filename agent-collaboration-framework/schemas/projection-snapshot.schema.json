{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projection-snapshot.schema.json",
  "$defs": {
    "InventoryItemView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_label": {
          "default": "",
          "title": "Source Label",
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "quantity",
        "condition",
        "version"
      ],
      "title": "InventoryItemView",
      "type": "object"
    },
    "JsonValue": {},
    "ProjectionActionDeclarationOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "semantic_hints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Hints",
          "type": "array"
        }
      },
      "required": [
        "id",
        "semantic_hints"
      ],
      "title": "ProjectionActionDeclarationOption",
      "type": "object"
    },
    "ProjectionActorResource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ProjectionActorResource",
      "type": "object"
    },
    "ProjectionActorValue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ProjectionActorValue",
      "type": "object"
    },
    "ProjectionAvailableExit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionExitDestination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectionAvailableExit",
      "type": "object"
    },
    "ProjectionCheckpointOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "action_hint": {
          "minLength": 1,
          "title": "Action Hint",
          "type": "string"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": [
                "regular",
                "hard",
                "extreme"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "declaration_options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionActionDeclarationOption"
          },
          "title": "Declaration Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "target_id",
        "action_hint"
      ],
      "title": "ProjectionCheckpointOption",
      "type": "object"
    },
    "ProjectionEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "npc",
            "object",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionNarrativeDetail"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "observable_state": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionObservableState"
          },
          "title": "Observable State",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ],
      "title": "ProjectionEntity",
      "type": "object"
    },
    "ProjectionExitDestination": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "name"
      ],
      "title": "ProjectionExitDestination",
      "type": "object"
    },
    "ProjectionKnownInformation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "related_entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Entities",
          "type": "array"
        },
        "related_scenes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Scenes",
          "type": "array"
        },
        "scope": {
          "enum": [
            "actor",
            "party"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "content",
        "scope"
      ],
      "title": "ProjectionKnownInformation",
      "type": "object"
    },
    "ProjectionKnownLocation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "region",
            "site",
            "room",
            "connector"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "parent_location_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Location Id"
        },
        "region_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "existence": {
          "enum": [
            "rumored",
            "known"
          ],
          "title": "Existence",
          "type": "string"
        },
        "localization": {
          "enum": [
            "unknown",
            "approximate",
            "located"
          ],
          "title": "Localization",
          "type": "string"
        },
        "access": {
          "enum": [
            "unknown",
            "reachable",
            "blocked"
          ],
          "title": "Access",
          "type": "string"
        },
        "visited": {
          "default": false,
          "title": "Visited",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "existence",
        "localization",
        "access"
      ],
      "title": "ProjectionKnownLocation",
      "type": "object"
    },
    "ProjectionLocationBreadcrumb": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectionLocationBreadcrumb",
      "type": "object"
    },
    "ProjectionLocationContext": {
      "additionalProperties": false,
      "properties": {
        "current_location_id": {
          "minLength": 1,
          "title": "Current Location Id",
          "type": "string"
        },
        "breadcrumbs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionLocationBreadcrumb"
          },
          "title": "Breadcrumbs",
          "type": "array"
        },
        "position_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectionPositionContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "current_location_id"
      ],
      "title": "ProjectionLocationContext",
      "type": "object"
    },
    "ProjectionNarrativeDetail": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "description",
            "sensory",
            "atmosphere",
            "pacing",
            "foreshadowing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "ProjectionNarrativeDetail",
      "type": "object"
    },
    "ProjectionObservableState": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "key",
        "label",
        "value"
      ],
      "title": "ProjectionObservableState",
      "type": "object"
    },
    "ProjectionPositionContext": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "access_boundary",
          "default": "access_boundary",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "locked",
            "blocked",
            "interaction_required"
          ],
          "title": "State",
          "type": "string"
        },
        "destination_id": {
          "minLength": 1,
          "title": "Destination Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "state",
        "destination_id"
      ],
      "title": "ProjectionPositionContext",
      "type": "object"
    },
    "ProjectionScene": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionNarrativeDetail"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "visible_entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionEntity"
          },
          "title": "Visible Entities",
          "type": "array"
        },
        "visible_actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionVisibleActor"
          },
          "title": "Visible Actors",
          "type": "array"
        },
        "available_exits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionAvailableExit"
          },
          "title": "Available Exits",
          "type": "array"
        },
        "loose_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InventoryItemView"
          },
          "title": "Loose Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "ProjectionScene",
      "type": "object"
    },
    "ProjectionSelfActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionActorValue"
          },
          "title": "Attributes",
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionActorValue"
          },
          "title": "Skills",
          "type": "array"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProjectionActorResource"
          },
          "title": "Resources",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "equipment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Equipment",
          "type": "array"
        },
        "background_summary": {
          "default": "",
          "title": "Background Summary",
          "type": "string"
        },
        "public_status_summary": {
          "default": "",
          "title": "Public Status Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectionSelfActor",
      "type": "object"
    },
    "ProjectionVisibleActor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "status_summary": {
          "default": "",
          "title": "Status Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectionVisibleActor",
      "type": "object"
    },
    "ProjectionWorldState": {
      "additionalProperties": false,
      "description": "Player-safe world facts the Engine commits outside the current scene.\n\nThese are the projections of the world time (#245), `mark_core_resolved`,\n`set_ending_availability` and `commit_terminal_ending` effects: without them\nan Engine commit changes authoritative state that neither the Agent's next\nturn nor the player can observe.",
      "properties": {
        "day_index": {
          "default": 0,
          "minimum": 0,
          "title": "Day Index",
          "type": "integer"
        },
        "hour_of_day": {
          "default": 0,
          "maximum": 23,
          "minimum": 0,
          "title": "Hour Of Day",
          "type": "integer"
        },
        "time_of_day": {
          "default": "day",
          "enum": [
            "day",
            "night"
          ],
          "title": "Time Of Day",
          "type": "string"
        },
        "core_resolved": {
          "default": false,
          "title": "Core Resolved",
          "type": "boolean"
        },
        "ending_available": {
          "default": false,
          "title": "Ending Available",
          "type": "boolean"
        },
        "ending_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ending Id"
        }
      },
      "title": "ProjectionWorldState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Read-only, GameState-free source consumed by A's projector.",
  "properties": {
    "room_id": {
      "minLength": 1,
      "title": "Room Id",
      "type": "string"
    },
    "player_id": {
      "minLength": 1,
      "title": "Player Id",
      "type": "string"
    },
    "actor_id": {
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "background": {
      "minLength": 1,
      "title": "Background",
      "type": "string"
    },
    "scene_id": {
      "minLength": 1,
      "title": "Scene Id",
      "type": "string"
    },
    "phase": {
      "enum": [
        "playing",
        "ended"
      ],
      "title": "Phase",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "self_actor": {
      "$ref": "#/$defs/ProjectionSelfActor"
    },
    "scene": {
      "$ref": "#/$defs/ProjectionScene"
    },
    "location_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectionLocationContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "known_locations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectionKnownLocation"
      },
      "title": "Known Locations",
      "type": "array"
    },
    "inventory": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryItemView"
      },
      "title": "Inventory",
      "type": "array"
    },
    "world": {
      "$ref": "#/$defs/ProjectionWorldState"
    },
    "known_information": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectionKnownInformation"
      },
      "title": "Known Information",
      "type": "array"
    },
    "checkpoint_options": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectionCheckpointOption"
      },
      "title": "Checkpoint Options",
      "type": "array"
    }
  },
  "required": [
    "room_id",
    "player_id",
    "actor_id",
    "background",
    "scene_id",
    "phase",
    "revision",
    "self_actor",
    "scene"
  ],
  "title": "ProjectionSnapshot",
  "type": "object"
}
