    "room_id": {
      "minLength": 1,
      "title": "Room Id",
      "type": "string"
    },
    "player_id": {
      "minLength": 1,
      "title": "Player Id",
      "type": "string"
    },
    "actor_id": {
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "background": {
      "minLength": 1,
      "title": "Background",
      "type": "string"
    },
    "scene_id": {
      "minLength": 1,
      "title": "Scene Id",
      "type": "string"
    },
    "phase": {
      "enum": [
        "playing",
        "ended"
