      "title": "Phase",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "self_actor": {
      "$ref": "#/$defs/ProjectionSelfActor"
    },
    "scene": {
      "$ref": "#/$defs/ProjectionScene"
    },
    "known_information": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectionKnownInformation"
      },
      "title": "Known Information",
      "type": "array"
