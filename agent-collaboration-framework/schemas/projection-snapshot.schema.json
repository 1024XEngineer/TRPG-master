      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectionAvailableExit",
      "type": "object"
    },
    "ProjectionCheckpointOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
