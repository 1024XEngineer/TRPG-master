{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "websocket-output.schema.json",
  "$defs": {
    "ActionDeclarationOption": {
      "additionalProperties": false,
      "description": "Player-safe declaration id and semantic cues supplied by one checkpoint.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "semantic_hints": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Hints",
          "type": "array"
        }
      },
      "required": [
        "id",
        "semantic_hints"
      ],
      "title": "ActionDeclarationOption",
      "type": "object"
    },
    "ActorResourceView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ActorResourceView",
      "type": "object"
    },
    "ActorValueView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "ActorValueView",
      "type": "object"
    },
    "AvailableExitView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitDestinationView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "AvailableExitView",
      "type": "object"
    },
    "CheckpointOption": {
      "additionalProperties": false,
      "description": "Trusted candidate menu exposed to the host semantic matcher.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "action_hint": {
          "minLength": 1,
          "title": "Action Hint",
          "type": "string"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": [
                "regular",
                "hard",
                "extreme"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "declaration_options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionDeclarationOption"
          },
          "title": "Declaration Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "target_id",
        "action_hint"
      ],
      "title": "CheckpointOption",
      "type": "object"
    },
    "ExitDestinationView": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "name"
      ],
      "title": "ExitDestinationView",
      "type": "object"
    },
    "InventoryItemView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source_label": {
          "default": "",
          "title": "Source Label",
          "type": "string"
        },
        "quantity": {
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "quantity",
        "condition",
        "version"
      ],
      "title": "InventoryItemView",
      "type": "object"
    },
    "JsonValue": {},
    "KnownInformationView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "related_entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Entities",
          "type": "array"
        },
        "related_scenes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Scenes",
          "type": "array"
        },
        "scope": {
          "enum": [
            "actor",
            "party"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "content",
        "scope"
      ],
      "title": "KnownInformationView",
      "type": "object"
    },
    "KnownLocationView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "region",
            "site",
            "room",
            "connector"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "parent_location_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Location Id"
        },
        "region_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "existence": {
          "enum": [
            "rumored",
            "known"
          ],
          "title": "Existence",
          "type": "string"
        },
        "localization": {
          "enum": [
            "unknown",
            "approximate",
            "located"
          ],
          "title": "Localization",
          "type": "string"
        },
        "access": {
          "enum": [
            "unknown",
            "reachable",
            "blocked"
          ],
          "title": "Access",
          "type": "string"
        },
        "visited": {
          "default": false,
          "title": "Visited",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "existence",
        "localization",
        "access"
      ],
      "title": "KnownLocationView",
      "type": "object"
    },
    "LocationBreadcrumbView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "LocationBreadcrumbView",
      "type": "object"
    },
    "LocationContextView": {
      "additionalProperties": false,
      "properties": {
        "current_location_id": {
          "minLength": 1,
          "title": "Current Location Id",
          "type": "string"
        },
        "breadcrumbs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LocationBreadcrumbView"
          },
          "title": "Breadcrumbs",
          "type": "array"
        },
        "position_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionContextView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "current_location_id"
      ],
      "title": "LocationContextView",
      "type": "object"
    },
    "NarrationOutput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "narration",
          "enum": [
            "narration",
            "clarification"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "claimed_fact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Claimed Fact Ids",
          "type": "array"
        },
        "suggested_actions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suggested Actions",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "NarrationOutput",
      "type": "object"
    },
    "NarrativeDetailView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "description",
            "sensory",
            "atmosphere",
            "pacing",
            "foreshadowing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "text"
      ],
      "title": "NarrativeDetailView",
      "type": "object"
    },
    "ObservableStateView": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "key",
        "label",
        "value"
      ],
      "title": "ObservableStateView",
      "type": "object"
    },
    "PlayerTurnPayload": {
      "additionalProperties": false,
      "properties": {
        "room_id": {
          "title": "Room Id",
          "type": "string"
        },
        "player_id": {
          "title": "Player Id",
          "type": "string"
        },
        "actor_id": {
          "title": "Actor Id",
          "type": "string"
        },
        "narration": {
          "$ref": "#/$defs/NarrationOutput"
        },
        "player_view": {
          "$ref": "#/$defs/PlayerView"
        }
      },
      "required": [
        "room_id",
        "player_id",
        "actor_id",
        "narration",
        "player_view"
      ],
      "title": "PlayerTurnPayload",
      "type": "object"
    },
    "PlayerView": {
      "additionalProperties": false,
      "description": "Complete player-safe world snapshot used by one model/Agent run.",
      "properties": {
        "room_id": {
          "minLength": 1,
          "title": "Room Id",
          "type": "string"
        },
        "player_id": {
          "minLength": 1,
          "title": "Player Id",
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "background": {
          "minLength": 1,
          "title": "Background",
          "type": "string"
        },
        "scene_id": {
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "playing",
            "ended"
          ],
          "title": "Phase",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "self_actor": {
          "$ref": "#/$defs/SelfActorView"
        },
        "scene": {
          "$ref": "#/$defs/SceneView"
        },
        "location_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocationContextView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "known_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnownLocationView"
          },
          "title": "Known Locations",
          "type": "array"
        },
        "inventory": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InventoryItemView"
          },
          "title": "Inventory",
          "type": "array"
        },
        "world": {
          "$ref": "#/$defs/WorldStateView"
        },
        "known_information": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnownInformationView"
          },
          "title": "Known Information",
          "type": "array"
        },
        "checkpoint_options": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CheckpointOption"
          },
          "title": "Checkpoint Options",
          "type": "array"
        }
      },
      "required": [
        "room_id",
        "player_id",
        "actor_id",
        "background",
        "scene_id",
        "phase",
        "revision",
        "self_actor",
        "scene"
      ],
      "title": "PlayerView",
      "type": "object"
    },
    "PositionContextView": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "access_boundary",
          "default": "access_boundary",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "locked",
            "blocked",
            "interaction_required"
          ],
          "title": "State",
          "type": "string"
        },
        "destination_id": {
          "minLength": 1,
          "title": "Destination Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "state",
        "destination_id"
      ],
      "title": "PositionContextView",
      "type": "object"
    },
    "SceneView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrativeDetailView"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "visible_entities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleEntity"
          },
          "title": "Visible Entities",
          "type": "array"
        },
        "visible_actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleActorView"
          },
          "title": "Visible Actors",
          "type": "array"
        },
        "available_exits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AvailableExitView"
          },
          "title": "Available Exits",
          "type": "array"
        },
        "loose_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InventoryItemView"
          },
          "title": "Loose Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "SceneView",
      "type": "object"
    },
    "SelfActorView": {
      "additionalProperties": false,
      "description": "The requesting player's actor; only public_status_summary may be shared.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "attributes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorValueView"
          },
          "title": "Attributes",
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorValueView"
          },
          "title": "Skills",
          "type": "array"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorResourceView"
          },
          "title": "Resources",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "equipment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Equipment",
          "type": "array"
        },
        "background_summary": {
          "default": "",
          "title": "Background Summary",
          "type": "string"
        },
        "public_status_summary": {
          "default": "",
          "title": "Public Status Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "SelfActorView",
      "type": "object"
    },
    "VisibleActorView": {
      "additionalProperties": false,
      "description": "Another actor currently visible to this player, with public fields only.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "occupation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occupation"
        },
        "status_summary": {
          "default": "",
          "title": "Status Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "VisibleActorView",
      "type": "object"
    },
    "VisibleEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "npc",
            "object",
            "location"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "narrative_details": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NarrativeDetailView"
          },
          "title": "Narrative Details",
          "type": "array"
        },
        "observable_state": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservableStateView"
          },
          "title": "Observable State",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description"
      ],
      "title": "VisibleEntity",
      "type": "object"
    },
    "WorldStateView": {
      "additionalProperties": false,
      "description": "Player-safe world facts committed outside the current scene.\n\nSee :class:`ProjectionWorldState`; this is the same data on the model/UI\nside of the projector.",
      "properties": {
        "day_index": {
          "default": 0,
          "minimum": 0,
          "title": "Day Index",
          "type": "integer"
        },
        "hour_of_day": {
          "default": 0,
          "maximum": 23,
          "minimum": 0,
          "title": "Hour Of Day",
          "type": "integer"
        },
        "time_of_day": {
          "default": "day",
          "enum": [
            "day",
            "night"
          ],
          "title": "Time Of Day",
          "type": "string"
        },
        "core_resolved": {
          "default": false,
          "title": "Core Resolved",
          "type": "boolean"
        },
        "ending_available": {
          "default": false,
          "title": "Ending Available",
          "type": "boolean"
        },
        "ending_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ending Id"
        }
      },
      "title": "WorldStateView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1",
      "default": "1",
      "title": "Protocol Version",
      "type": "string"
    },
