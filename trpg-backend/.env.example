# development | production | test
APP_ENV=development

# 本地默认用 SQLite 即可跑通全流程；生产切换为 PostgreSQL 异步驱动
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trpg

# 是否开启 /docs /redoc /openapi.json，本地开发默认开启
ENABLE_DOCS=true

LOG_LEVEL=INFO

# JSON 数组格式
CORS_ORIGINS=["http://localhost:9877"]

# 默认 fake 可离线运行；启用简单 Host/Narrator LLM 时改为 openai 并填写密钥。
HOST_MODEL_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
