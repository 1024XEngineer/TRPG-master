# development | production | test
APP_ENV=development

# 本地默认用 SQLite 即可跑通全流程；生产切换为 PostgreSQL 异步驱动
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trpg

# 是否开启 /docs /redoc /openapi.json，本地开发默认开启
ENABLE_DOCS=true

LOG_LEVEL=INFO

# 主持人模型与 Narrator：默认 fake 可离线运行，填入对应 Key 后再切换 provider。
# 默认 fake 可离线运行；可切换为 openai、qwen 或 deepseek 并填写对应密钥。
HOST_MODEL_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30

# 千问使用 Chat Completions JSON Mode；生产环境优先使用百炼业务空间专属地址。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_SECONDS=30

# OpenAI-compatible provider 示例：默认值对应 DeepSeek 官方服务。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
# 一键建卡的数值始终由本地规则生成；deepseek 创作装备与背景，失败自动回退模板。
CHARACTER_BACKGROUND_PROVIDER=deterministic
HOST_AGENT_MAX_TURNS=6
HOST_AGENT_MAX_TOOL_CALLS=8
HOST_AGENT_TOOL_TIMEOUT_SECONDS=5
HOST_AGENT_TIMEOUT_SECONDS=30
# 开场单独控制模型/模板模式与总超时；失败会自动使用玩家安全模板。
OPENING_NARRATION_MODE=model
OPENING_NARRATION_TIMEOUT_SECONDS=10
RECENT_HISTORY_ENABLED=true
RECENT_HISTORY_MAX_TURNS=6
RECENT_HISTORY_MAX_CHARS=6000
ACTION_PLAN_MAX_REPAIR_ATTEMPTS=1

# 角色生图（issue #199）：建卡完成页默认显示入口，玩家可自行选择是否生图。
# 默认不需要修改这个开关；如需紧急关闭后端生图接口，才设为 false。
CHARACTER_PORTRAIT_ENABLED=true
# 提示词默认走确定性模板，不需要 LLM Key 也可生图；需要 DeepSeek 整理时设为 deepseek。
PORTRAIT_PROMPT_PROVIDER=deterministic
# auto 会依次选择 Sufy、DashScope，两者均未配置时使用 mock。
# 仅在需要强制使用某一服务时才改为 sufy、dashscope 或 mock。
PORTRAIT_IMAGE_PROVIDER=auto
# 云端 Key 只能放在后端 .env，禁止使用 VITE_ 前缀或写入前端配置。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-flash
SUFY_API_KEY=
SUFY_BASE_URL=https://openai.sufy.com/v1
SUFY_IMAGE_MODEL=google/gemini-3-pro-image
# 使用新厂商的完整双模型链路时，改用下面这一组配置；同一把兼容 key
# 可以同时填入 DEEPSEEK_API_KEY 和 SUFY_API_KEY，但变量仍按用途分开。
# DEEPSEEK_BASE_URL=https://api.qnaigc.com/v1
# DEEPSEEK_MODEL=deepseek/deepseek-v4-pro-202606
# PORTRAIT_PROMPT_PROVIDER=deepseek
# PORTRAIT_IMAGE_PROVIDER=sufy
# 项目内置漫画风格参考图由后端读取并随镜像打包，不需要公网 URL。
# 参考图只用于锁定线稿、上色和光影风格；留空或文件不可读时降级为纯提示词。
PORTRAIT_REFERENCE_IMAGE_PATH=app/assets/portrait-style-reference.png
# 包括提示词调用和图片生成的单次总超时，高质量模型可适当调大。
PORTRAIT_GENERATION_TIMEOUT_SECONDS=120
# 上游图片会下载并校验后存入数据库；单张默认最多 5 MiB，下载阶段单独限时。
PORTRAIT_MAX_IMAGE_BYTES=5242880
PORTRAIT_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15

# AI 主持人语音。默认 disabled，不配置凭证也能正常启动；fake 只用于测试/E2E。
HOST_SPEECH_PROVIDER=disabled
DOUBAO_TTS_API_KEY=
# DouBao-Seed-TTS 2.0 的公开固定服务标识，不是控制台显示的实例或密钥 ID。
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# TRPG 推荐音色白名单：均来自火山引擎官方 TTS 2.0 公版音色列表。
# 儒雅逸辰适合作为常驻主持旁白；其余音色覆盖剧情演绎、清晰播报、悬疑角色
# 以及夹杂英文的模组。房主可在游戏页面从此列表中切换房间统一音色。
DOUBAO_TTS_VOICES=[{"voiceType":"zh_male_ruyayichen_saturn_bigtts","label":"儒雅逸辰 · 默认旁白"},{"voiceType":"zh_male_dayi_saturn_bigtts","label":"大壹 · 剧情演绎"},{"voiceType":"zh_female_santongyongns_saturn_bigtts","label":"流畅女声 · 清晰旁白"},{"voiceType":"zh_female_mizai_saturn_bigtts","label":"黑猫侦探社咪仔 · 悬疑角色"},{"voiceType":"zh_female_vv_uranus_bigtts","label":"Vivi 2.0 · 中英通用"},{"voiceType":"zh_male_xuanyijieshuo_uranus_bigtts","label":"悬疑解说 · 悬疑旁白"},{"voiceType":"zh_male_dongfanghaoran_uranus_bigtts","label":"东方浩然 · 沉稳男声"}]
DOUBAO_TTS_DEFAULT_VOICE_TYPE=zh_male_ruyayichen_saturn_bigtts
DOUBAO_TTS_TIMEOUT_SECONDS=15
HOST_SPEECH_MAX_SENTENCE_BYTES=900
HOST_SPEECH_CACHE_TTL_SECONDS=3600
HOST_SPEECH_CACHE_MAX_BYTES=67108864
HOST_SPEECH_PLAYER_REQUESTS_PER_MINUTE=60
HOST_SPEECH_ROOM_MISSES_PER_MINUTE=30
HOST_SPEECH_MAX_CONCURRENCY=8
CORS_ORIGINS=["http://localhost:9877"]

# 不配则 AI 主持人叙事回退到确定性占位文案（CI/e2e 默认如此）；配了走真实 DeepSeek
# DEEPSEEK_API_KEY=
