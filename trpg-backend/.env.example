# development | production | test
APP_ENV=development

# 本地默认用 SQLite 即可跑通全流程；生产切换为 PostgreSQL 异步驱动
DATABASE_URL=sqlite+aiosqlite:///./app.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trpg

# 是否开启 /docs /redoc /openapi.json，本地开发默认开启
ENABLE_DOCS=true

LOG_LEVEL=INFO

# JSON 数组格式
CORS_ORIGINS=["http://localhost:9877","http://127.0.0.1:9877"]

# 默认 fake 可离线运行；可切换为 openai、qwen 或 deepseek 并填写对应密钥。
HOST_MODEL_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30

# 千问使用 Chat Completions JSON Mode；生产环境优先使用百炼业务空间专属地址。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_SECONDS=30

# OpenAI-compatible provider 示例：DeepSeek 是首个内置实现。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
HOST_AGENT_MAX_TURNS=6
HOST_AGENT_MAX_TOOL_CALLS=8
HOST_AGENT_TOOL_TIMEOUT_SECONDS=5
HOST_AGENT_TIMEOUT_SECONDS=30
RECENT_HISTORY_ENABLED=true
RECENT_HISTORY_MAX_TURNS=6
RECENT_HISTORY_MAX_CHARS=6000

# DEEPSEEK_API_KEY 同时用于 Host Agent 和讨论区 Narrator；未配置则使用占位叙事。
# 测试专用：延迟 Narrator 以稳定覆盖行动锁并发场景。
NARRATOR_DELAY_SECONDS=0

# 建卡完成后的可选角色生图（issue #199）。默认关闭，不产生外部调用。
CHARACTER_PORTRAIT_ENABLED=false
PORTRAIT_PROMPT_PROVIDER=deterministic
PORTRAIT_IMAGE_PROVIDER=mock
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=wan2.2-t2i-flash
PORTRAIT_GENERATION_TIMEOUT_SECONDS=120
CORS_ORIGINS=["http://localhost:9877"]

# 不配则 AI 主持人叙事回退到确定性占位文案（CI/e2e 默认如此）；配了走真实 DeepSeek
# DEEPSEEK_API_KEY=
